# Copy to .env.release and fill in. Used by Scripts/release.sh.
#
# This file carries NO secrets and is safe to read. The notarization password
# lives in the keychain, stored once with:
#
#     xcrun notarytool store-credentials "searoom-notary" \
#         --apple-id <your-apple-id> --team-id <your-team-id>
#
# NOTARY_KEYCHAIN_PROFILE below names that keychain entry; it is not the password.

# Exact name of the Developer ID certificate, as printed by:
#     security find-identity -v -p codesigning
CODE_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Name given to the stored notarytool credential.
NOTARY_KEYCHAIN_PROFILE="searoom-notary"
